# Environment
NODE_ENV=development

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=blindtest

# Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Stripe Configuration (Multi-tenant payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (created once in Stripe Dashboard)
# PER_EVENT: One-time payment of 19€
STRIPE_PRICE_PER_EVENT=price_per_event_replace_with_real_id
# MONTHLY: Recurring monthly payment of 49€
STRIPE_PRICE_MONTHLY=price_monthly_replace_with_real_id
# Temporary Sessions
STRIPE_PRICE_2DAYS=price_2days_replace_with_real_id
STRIPE_PRICE_1WEEK=price_1week_replace_with_real_id
STRIPE_PRICE_1MONTH=price_1month_replace_with_real_id

# Multi-tenant Configuration
APP_BASE_URL=http://localhost:4200
SUPER_ADMIN_EMAIL=admin@blindtest.local
SUPER_ADMIN_PASSWORD=change-this-password

# Email Configuration (SMTP Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@codeharmony.com
SMTP_PASS=your-email-password-here
EMAIL_FROM=support@codeharmony.com
EMAIL_FROM_NAME=Blind Test Musical

# Optional: Custom domain support
# DOMAIN_BASE=blindtest.com
