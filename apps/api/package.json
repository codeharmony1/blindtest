{
  "name": "@blindtest/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migrate:generate": "npm run typeorm -- migration:generate ./src/db/migrations/Init",
    "migrate:run": "npm run typeorm -- migration:run",
    "migrate:multi-tenant": "ts-node src/db/migrate-multi-tenant.ts",
    "migrate:step-by-step": "ts-node src/db/migrate-step-by-step.ts",
    "migrate:existing-tables": "ts-node src/db/migrate-existing-tables.ts",
    "finalize:migration": "ts-node src/db/finalize-migration.ts",
    "seed:demo": "ts-node src/db/seed-demo.ts",
    "init:db": "ts-node src/scripts/init-database.ts",
    "create:super-admin": "ts-node src/scripts/create-super-admin.ts",
    "create:super-admin:test": "ts-node src/scripts/create-super-admin-test.ts",
    "validate:system": "ts-node src/tests/system-validation.ts",
    "check:health": "curl http://localhost:3001/api/health || echo 'Server not running'",
    "test:endpoints": "ts-node test-critical-endpoints.ts"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "nodemailer": "^7.0.9",
    "socket.io": "^4.7.5",
    "stripe": "^18.5.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.5.4"
  }
}
