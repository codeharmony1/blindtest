# ============================================
# BLIND TEST MUSICAL - PRODUCTION ENVIRONMENT
# ============================================
# À copier vers .env.production et remplir avec vos vraies valeurs
# À placer sur le serveur dans le dossier du projet

# ============================================
# DATABASE (MariaDB)
# ============================================
BLINDTEST_DB_USER=blindtest_user
BLINDTEST_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Note: La base 'blindtest' doit être créée manuellement sur MariaDB

# ============================================
# SECURITY & JWT
# ============================================
# Générer avec: openssl rand -base64 64
BLINDTEST_JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_256_BIT_SECRET_HERE

# ============================================
# SUPER ADMIN
# ============================================
BLINDTEST_SUPER_ADMIN_EMAIL=admin@blindtest.codeharmony.fr
BLINDTEST_SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================
# EMAIL (SMTP Hostinger)
# ============================================
BLINDTEST_SMTP_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
# Les autres paramètres SMTP sont hardcodés dans docker-compose:
# - SMTP_HOST: smtp.hostinger.com
# - SMTP_PORT: 465
# - SMTP_USER: support@codeharmony.com

# ============================================
# STRIPE (Paiements)
# ============================================
# MODE TEST (pour tests)
#BLINDTEST_STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#BLINDTEST_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#BLINDTEST_STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MODE PRODUCTION (mettre les vraies clés Stripe production)
BLINDTEST_STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
BLINDTEST_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
BLINDTEST_STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# REDIS (Cache & Sessions)
# ============================================
# Générer avec: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ============================================
# AUTRES VARIABLES (depuis votre .env existant)
# ============================================
# Ces variables doivent déjà exister dans votre .env serveur:
# - MARIADB_ROOT_PASSWORD
# - Traefik est configuré et fonctionne
# - Réseaux Docker 'proxy' et 'backend' existent

# ============================================
# INSTRUCTIONS DE DÉPLOIEMENT
# ============================================
#
# 1. Sur le serveur, créer la base de données MariaDB:
#    docker exec -it mariadb mysql -u root -p
#    CREATE DATABASE blindtest CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#    CREATE USER 'blindtest_user'@'%' IDENTIFIED BY 'VOTRE_MOT_DE_PASSE';
#    GRANT ALL PRIVILEGES ON blindtest.* TO 'blindtest_user'@'%';
#    FLUSH PRIVILEGES;
#    EXIT;
#
# 2. Copier ce fichier vers .env.production et remplir les valeurs
#
# 3. Fusionner docker-compose.prod.yml dans votre docker-compose.yml principal
#
# 4. Construire et démarrer les services:
#    docker-compose up -d --build blindtest-api blindtest-web redis
#
# 5. Exécuter les migrations de base de données:
#    docker exec -it blindtest-api npm run migrate:run
#
# 6. Vérifier les logs:
#    docker logs -f blindtest-api
#    docker logs -f blindtest-web
#
# 7. Tester l'application:
#    https://blindtest.codeharmony.fr
#    https://api.blindtest.codeharmony.fr/api/health
#
# 8. Configurer le webhook Stripe:
#    URL: https://api.blindtest.codeharmony.fr/api/payments/webhooks/stripe
#    Événements à écouter:
#    - checkout.session.completed
#    - customer.subscription.created
#    - customer.subscription.updated
#    - customer.subscription.deleted
#    - payment_intent.succeeded
#    - payment_intent.payment_failed
#
