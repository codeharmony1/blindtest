# ============================================
# CONFIGURATION PRODUCTION - BLIND TEST MUSICAL
# ============================================
# ⚠️ NE JAMAIS COMMITTER CE FICHIER AVEC LES VRAIES VALEURS
# ⚠️ Remplacer tous les placeholders par vos vraies valeurs
# ============================================

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# BASE DE DONNÉES (MariaDB/MySQL)
# ============================================
# ⚠️ OBLIGATOIRE - Créer la base avant le premier déploiement
DB_HOST=localhost
# Si DB sur container Docker séparé, utiliser le nom du service : DB_HOST=mariadb
DB_PORT=3306
DB_USER=blindtest_prod
DB_PASS=CHANGEZ_MOI_mot_de_passe_DB_ultra_securise_32_caracteres_minimum
DB_NAME=blindtest_production

# ============================================
# JWT AUTHENTICATION
# ============================================
# ⚠️ SECRETS PRÉ-GÉNÉRÉS SÉCURISÉS (128 caractères hex)
# ⚠️ NE JAMAIS PARTAGER CES SECRETS
JWT_SECRET=2af150f1a52a0bbc8dfca9094bc9ff03db4e2bb404e1ac56da087767dfae0a62ca3b233cacfbff7dfc2fadf2707584370a32ee94fc0e1247f9c653bd92939b9d
JWT_REFRESH_SECRET=c5523c9f5fb95d13207c6ffec06289e75fbfc5d3c3fb0607fffee9a841df20ee6181d7676a5c5f2b0296c17c56c248be65a57dc626dccf5b37806d14fe006232

# Durées d'expiration des tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# STRIPE CONFIGURATION (LIVE MODE)
# ============================================
# ⚠️ UTILISER LES CLÉS LIVE (sk_live_ et pk_live_)
# Récupérer depuis : https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_live_CHANGEZ_MOI_votre_cle_stripe_live
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGEZ_MOI_votre_cle_publique_stripe_live
STRIPE_WEBHOOK_SECRET=whsec_CHANGEZ_MOI_secret_webhook_stripe

# ============================================
# STRIPE PRICE IDS (Préconfigurés dans Dashboard)
# ============================================
# ⚠️ CRÉER CES PRIX DANS STRIPE DASHBOARD (LIVE MODE) AVANT DÉPLOIEMENT
# Guide : https://dashboard.stripe.com/products
#
# 1. Créer Produit "Paiement par Événement" → Prix 19.00 EUR (one-time)
#    → Copier Price ID (commence par price_)
STRIPE_PRICE_PER_EVENT=price_CHANGEZ_MOI_19_euros_paiement_unique

# 2. Créer Produit "Plan Mensuel" → Prix 49.00 EUR (recurring monthly)
#    → Copier Price ID
STRIPE_PRICE_MONTHLY=price_CHANGEZ_MOI_49_euros_par_mois

# 3. Créer Produit "Session Temporaire 2 jours" → Prix X EUR (one-time)
STRIPE_PRICE_2DAYS=price_CHANGEZ_MOI_session_2_jours

# 4. Créer Produit "Session Temporaire 1 semaine" → Prix X EUR (one-time)
STRIPE_PRICE_1WEEK=price_CHANGEZ_MOI_session_1_semaine

# 5. Créer Produit "Session Temporaire 1 mois" → Prix X EUR (one-time)
STRIPE_PRICE_1MONTH=price_CHANGEZ_MOI_session_1_mois

# ============================================
# EMAIL SMTP CONFIGURATION
# ============================================
# ⚠️ OBLIGATOIRE pour reset password et notifications

# Option 1 : Hostinger (Recommandé)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@votre-domaine.com
SMTP_PASS=CHANGEZ_MOI_mot_de_passe_email_smtp
EMAIL_FROM=support@votre-domaine.com

# Option 2 : Gmail (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=mot_de_passe_application_gmail
# EMAIL_FROM=votre-email@gmail.com

# Option 3 : SendGrid (Alternative)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=votre_api_key_sendgrid
# EMAIL_FROM=noreply@votre-domaine.com

# ============================================
# API SERVER CONFIGURATION
# ============================================
API_PORT=3001
API_HOST=0.0.0.0

# ⚠️ CORS : Autoriser uniquement votre domaine frontend
CORS_ORIGIN=https://votre-domaine.com
# Si sous-domaine séparé : CORS_ORIGIN=https://app.votre-domaine.com

# ============================================
# FRONTEND URL (Pour redirection emails, etc.)
# ============================================
FRONTEND_URL=https://votre-domaine.com
# Si sous-domaine : FRONTEND_URL=https://app.votre-domaine.com

# ============================================
# RATE LIMITING (Déjà configuré dans le code)
# ============================================
# Ces valeurs sont optionnelles, les defaults sont sécurisés
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100   # 100 requêtes par fenêtre
# AUTH_RATE_LIMIT_MAX=5         # 5 tentatives login par 15 min

# ============================================
# REDIS (Optionnel - pour sessions/cache)
# ============================================
# Si vous utilisez Redis pour les sessions
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=CHANGEZ_MOI_si_redis_protege

# ============================================
# MONITORING & LOGS (Optionnel mais recommandé)
# ============================================
# Sentry pour tracking erreurs production
# SENTRY_DSN=https://votre_cle_sentry@sentry.io/votre_projet

# Niveau de logs
LOG_LEVEL=info
# Options : error, warn, info, debug

# ============================================
# DÉPLOIEMENT DOCKER (Si utilisation docker-compose)
# ============================================
# Ces variables sont utilisées par docker-compose.prod.yml

# Domaine principal
DOMAIN=votre-domaine.com

# Sous-domaines (si utilisés)
API_SUBDOMAIN=api
APP_SUBDOMAIN=app

# Email pour Let's Encrypt SSL
LETSENCRYPT_EMAIL=moi@blabla.fr

# ============================================
# BACKUP CONFIGURATION (Recommandé)
# ============================================
# Chemin pour backups automatiques DB
BACKUP_PATH=/var/backups/blindtest
BACKUP_RETENTION_DAYS=30

# ============================================
# NOTES IMPORTANTES
# ============================================
#
# 1. SÉCURITÉ :
#    - Ne JAMAIS committer ce fichier avec les vraies valeurs
#    - Utiliser .gitignore pour exclure .env.production
#    - Stocker backup sécurisé des secrets (gestionnaire mots de passe)
#
# 2. STRIPE LIVE MODE :
#    - Tester d'abord en mode TEST (sk_test_)
#    - Basculer en LIVE seulement quand tout fonctionne
#    - Configurer webhooks : https://api.votre-domaine.com/api/payments/webhook
#    - Events à écouter : checkout.session.completed, customer.subscription.*
#
# 3. EMAIL SMTP :
#    - Tester l'envoi d'email avant prod (script de test fourni)
#    - Vérifier SPF/DKIM configurés pour éviter spam
#
# 4. BASE DE DONNÉES :
#    - Créer user DB dédié (pas root)
#    - Privilèges minimaux nécessaires
#    - Backups automatiques quotidiens
#
# 5. SSL/TLS :
#    - Obligatoire en production
#    - Let's Encrypt gratuit via Traefik (configuré dans docker-compose)
#    - Renouvellement automatique
#
# 6. PREMIER DÉPLOIEMENT :
#    - Exécuter migrations : npm run migrate:run
#    - Créer super-admin : npm run create:super-admin
#    - Tester health : curl https://api.votre-domaine.com/api/health
#
# ============================================
# COMMANDES UTILES PRODUCTION
# ============================================
#
# Déployer avec Docker :
#   docker-compose -f docker-compose.prod.yml up -d --build
#
# Voir logs :
#   docker-compose -f docker-compose.prod.yml logs -f api
#
# Migrations DB :
#   docker-compose -f docker-compose.prod.yml exec api npm run migrate:run
#
# Créer super-admin :
#   docker-compose -f docker-compose.prod.yml exec api npm run create:super-admin
#
# Backup DB :
#   docker-compose -f docker-compose.prod.yml exec mariadb \
#     mysqldump -u root -p blindtest_production > backup_$(date +%Y%m%d).sql
#
# Redémarrer services :
#   docker-compose -f docker-compose.prod.yml restart
#
# ============================================
